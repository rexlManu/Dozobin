APP_NAME=Dōzobin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://dozobin.ddev.site

# Production defaults to indexable. Set false for private installations.
SEO_INDEX=false
SEO_DESCRIPTION="Self-hosted file sharing for files, screenshots, and text, with expiring links, password protection, and accountless transfers between devices."
# SEO_IMAGE_URL=https://example.com/social-card.png

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db
DB_CONNECT_TIMEOUT=5

# Set to true when a deployment provisions the administrator and settings
# itself and should never see the installation wizard.
DOZOBIN_SKIP_INSTALLER=false
DOZOBIN_UPDATE_CHECK=true
# DOZOBIN_RELEASE_REPOSITORY=rexlManu/Dozobin
# DOZOBIN_UPDATE_CACHE_HOURS=24

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=REMOTE_ADDR

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Docker images set this to /data/files. Local development keeps Laravel's default.
# FILE_STORE_PATH=/data/files
# FILE_STORE_SIGNED_URL_TTL=60
QUEUE_CONNECTION=database

MALWARE_SCAN_QUEUE=scans
CLAMAV_UNIX_SOCKET=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT=2
CLAMAV_READ_TIMEOUT=120
CLAMAV_STREAM_CHUNK_BYTES=1048576

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
